<?xml version="1.0" encoding="utf-8"?>
<!--
  Chip-Beschriftung passend zum Hintergrund in chip_background.xml:
  inaktiv (state_enabled=false) gewinnt immer, dann gewaehlt, dann waehlbar.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/nothing_dim" />
    <item android:state_selected="true" android:color="@color/nothing_black" />
    <item android:color="@color/nothing_grey" />
</selector>
