# Kopieren nach keystore.properties und ausfuellen.
# keystore.properties steht in .gitignore und wird NICHT committet.
#
#   cp keystore.properties.example keystore.properties
#
# Zum Erzeugen eines neuen Keystores:
#   keytool -genkeypair -v -keystore bulkcompressor.keystore \
#     -alias bulkcompressor -keyalg RSA -keysize 4096 -validity 10000 \
#     -storetype PKCS12

storeFile=bulkcompressor.keystore
storePassword=CHANGE_ME
keyAlias=bulkcompressor
keyPassword=CHANGE_ME
