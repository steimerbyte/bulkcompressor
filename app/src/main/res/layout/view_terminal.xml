<?xml version="1.0" encoding="utf-8"?>
<!--
    Ausklappbares Live-Terminal am unteren Rand. Wird per <include> in ein
    FrameLayout gehaengt und ueberlagert den Inhalt, statt ihn zu verschieben.

    Zugeklappt: nur die 40dp-Leiste (terminal_bar). Ausgeklappt: Leiste, ein
    einziges TextView im ScrollView und die Text-Toolbar. Die Hoehe setzt
    TerminalPanel.kt programmatisch (Drag + Snap), deshalb steht hier
    wrap_content.

    Die Leiste ist gleichzeitig der Griff: Ziehen aendert die Hoehe, Tippen
    klappt um.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/terminal_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@color/nothing_black"
    android:orientation="vertical">

    <!-- Obere Kante: derselbe 1dp-Outline wie bei allen Containern. -->
    <View
        android:id="@+id/terminal_outline"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nothing_outline" />

    <!-- Leiste und Griff in einem. -->
    <LinearLayout
        android:id="@+id/terminal_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/nothing_surface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/terminal_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.18"
            android:text="@string/terminal_title"
            android:textColor="@color/nothing_white"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/terminal_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:textColor="@color/nothing_dim"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/terminal_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:text="@string/terminal_new_indicator"
            android:textColor="@color/nothing_grey"
            android:textSize="9sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/terminal_chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/terminal_chevron"
            android:textColor="@color/nothing_white"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Inhalt: genau ein TextView, gewrappt in einem ScrollView. -->
    <ScrollView
        android:id="@+id/terminal_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <TextView
            android:id="@+id/terminal_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="@color/nothing_white"
            android:textIsSelectable="true"
            android:textSize="9sp" />

    </ScrollView>

    <View
        android:id="@+id/terminal_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nothing_outline"
        android:visibility="gone" />

    <!-- Nur Text-Buttons; alle Aktionen laufen ueber die Lambdas. -->
    <LinearLayout
        android:id="@+id/terminal_toolbar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/nothing_surface"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/terminal_action_copy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="@string/terminal_action_copy"
            android:textColor="@color/nothing_white"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/terminal_action_share"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="@string/terminal_action_share"
            android:textColor="@color/nothing_white"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/terminal_action_clear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="@string/terminal_action_clear"
            android:textColor="@color/nothing_grey"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/terminal_action_close"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="@string/terminal_action_close"
            android:textColor="@color/nothing_white"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
