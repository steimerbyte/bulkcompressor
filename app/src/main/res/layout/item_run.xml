<?xml version="1.0" encoding="utf-8"?>
<!-- Eine Zeile der Laufhistorie: Ordner und Zeitpunkt, Balken, Ergebnis. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_run_folder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/nothing_white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/text_run_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/nothing_dim"
            android:textSize="9sp" />
    </LinearLayout>

    <com.steimerbyte.bulkcompressor.ui.SegmentBar
        android:id="@+id/bar_run"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_run_files"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="@color/nothing_grey"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/text_run_saved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/nothing_white"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/nothing_outline" />
</LinearLayout>
